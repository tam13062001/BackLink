# Port for the API server
PORT=4000

# Optional: Google Programmable Search (Custom Search JSON API)
# Needed only for the "Guest Post Finder" tab to return real search results.
# Docs: https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional: SerpAPI key, used instead of Google CSE if provided.
# https://serpapi.com/
SERPAPI_KEY=

# Required for the "Soạn email AI" feature (outreach draft writer).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Required to actually send outreach emails via Gmail.
# GMAIL_USER: your full Gmail address.
# GMAIL_APP_PASSWORD: a 16-character App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Safety cap: max outreach emails the tool will send per day, across all recipients.
# Keeps sending volume in "personalized outreach" territory, not "spam blast" territory.
MAX_EMAILS_PER_DAY=20
